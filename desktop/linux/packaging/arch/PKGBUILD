# Local Arch package: `makepkg -si` from packaging/arch/ (builds the crate two levels up).
pkgname=grabador-reuniones
pkgver=0.3.0
pkgrel=1
pkgdesc="Graba reuniones, las transcribe y levanta acta (Traventia)"
arch=('x86_64')
license=('LicenseRef-proprietary')
depends=('gtk4' 'libadwaita' 'ffmpeg' 'gst-plugins-base' 'gst-plugins-good')
makedepends=('cargo')
options=('!lto' '!debug')

build() {
  cd "$startdir/../.."
  cargo build --release --locked
}

package() {
  cd "$startdir/../.."
  install -Dm755 target/release/grabador-reuniones "$pkgdir/usr/bin/grabador-reuniones"
  install -Dm644 packaging/com.traventia.meeting-recorder.desktop "$pkgdir/usr/share/applications/com.traventia.meeting-recorder.desktop"
  install -Dm644 packaging/com.traventia.meeting-recorder.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.traventia.meeting-recorder.svg"
}
